        "repository": { "const": "threshold-network/tss-lib" },
        "identity": { "const": "d847ce0030193ccf5dbec0097571dcce5a2a5cf6" },
        "version": { "const": "v0.0.0-20260729021955-d847ce003019" },
        "checksum": { "const": "h1:EmD85fdfi20RKON39+Hho5zmB57gHj7EWd7pTYwsqRY=" },
        "verification": { "const": "go_mod_go_sum_and_upstream_commit" }
