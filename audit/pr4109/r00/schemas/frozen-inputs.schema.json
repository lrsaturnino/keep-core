        "version": { "const": null },
        "checksum": { "const": null },
        "verification": { "const": "upstream_commit" }
      }
    },
    "externalDoHarnessReference": {
      "$ref": "#/$defs/input",
      "properties": {
        "name": { "const": "external_do_harness_reference" },
        "repository": { "const": "tlabs-xyz/pr4109-do-infra" },
        "identity": { "const": "7cbecdde357af30eecb25cfba767851da9ce3dd4" },
        "version": { "const": null },
        "checksum": { "const": null },
        "verification": { "const": "unverified_external_scope_reference" }
