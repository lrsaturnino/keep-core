        "version": { "const": "v0.0.0-20230901144531-2e712689cfbe" },
        "checksum": { "const": "h1:dOKhoYxZjXwFIyGnxgU+Sa1obZPMHRhu6e44oOLkzU4=" },
        "verification": { "const": "prior_keep_core_go_mod_go_sum_and_upstream_commit" }
      }
