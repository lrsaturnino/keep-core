        "name": { "const": "candidate_keep_common" },
        "repository": { "const": "threshold-network/keep-common" },
        "identity": { "const": "v1.7.1-tlabs.1" },
        "version": { "const": "v1.7.1-tlabs.1" },
        "checksum": { "const": "h1:GcaQUb/5TOdc1Vhs4ZsbLM5a1C0CXx7Nmqv4npNKTag=" },
        "verification": { "const": "go_mod_go_sum" }
      }
    },
    "tbtcV2LifecycleReference": {
